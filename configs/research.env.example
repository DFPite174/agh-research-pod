# Configuration is read from the process environment; this file is a template only.
# Set these privately in the same terminal before starting AGH. Never commit secrets.
AGH_LLM_BASE_URL=https://your-compatible-provider.example/v1
AGH_LLM_MODEL=your-structured-output-model
AGH_LLM_API_KEY=
AGH_BACKTEST_ENGINE_ROOT=
AGH_ENGINE_PYTHON=
# Optional: explicit Git executable if git is not on PATH
AGH_GIT=
# Optional: otherwise auto-discover the accepted local AStockDB convention
AGH_ASTOCKDB_ROOT=
